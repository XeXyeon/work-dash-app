{
  "checks": [
    { "when": ["src/**"], "run": "npm run typecheck" },
    { "when": ["server/**/*.js"], "run": "node --check {files}" },
    { "when": ["desktop/**"], "run": "cargo check --manifest-path desktop/Cargo.toml" },
    { "when": ["server/**/*.js", "bin/**/*.js", "test/**/*.js", "lint/**/*.js", "eslint.config.js"], "run": "npm run lint" },
    { "when": ["bin/**", "server/**", "lint/**", "test/**"], "run": "npm test" }
  ],
  "full": "npm run lint && npm test && npm run build",
  "fullBeforePush": true,
  "fullOnly": ["npm run build"],
  "serve": ["npm run dev", "npm run server", "npm run dev:server", "npm run app:dev", "node server/index.js", "node scripts/dev.js", "work-dash start"]
}
