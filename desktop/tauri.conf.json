{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "work-dash",
  "version": "0.1.0",
  "identifier": "local.workdash.dashboard",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "work-dash",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "로드맵 · 이슈 · 작업 카드 대시보드",
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
