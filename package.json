{
  "name": "work-dash-app",
  "version": "0.1.0",
  "private": true,
  "description": "~/.work-dash 로드맵 · 이슈 · 작업 카드를 보는 데스크톱 앱(Tauri)과 로컬 서버",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "lint": "node lint/changed.js",
    "test": "node --test test/*.test.js",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "demo": "node demo/run.js",
    "app:dev": "tauri dev",
    "app:build": "tauri build --bundles app",
    "app:install": "node desktop/scripts/install.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "marked": "^16.4.2",
    "mermaid": "^11.17.2",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "bin": {
    "work-dash-app": "bin/work-dash-app.js"
  }
}
